# Copy to .env (and never commit the real one).
#
# DISCORD_PUBLIC_KEY is read by the running interactions.py service.
# DISCORD_TOKEN and DISCORD_APPLICATION_ID are only ever read by
# register_commands.py, by hand -- the live service never touches them.

# Developer Portal -> General Information -> "Public Key". Not a secret;
# it's published there so anyone can verify a request really came from
# Discord -- that's exactly what this does.
DISCORD_PUBLIC_KEY=paste-your-applications-public-key-here

# Developer Portal -> General Information -> "Application ID".
DISCORD_APPLICATION_ID=paste-your-application-id-here

# Developer Portal -> Bot -> "Reset Token". Treat it like a password --
# only register_commands.py ever reads this, and only when you run it.
DISCORD_TOKEN=paste-your-bot-token-here

# Optional: which repo the /fileissue link points at (defaults to
# kevinisgoated24-spec/OCforge -- only change this if you forked it).
#GITHUB_REPO=kevinisgoated24-spec/OCforge

# Optional: restrict /fileissue to one server (right-click the server icon
# in Discord with Developer Mode on -> Copy Server ID), and register the
# command as a guild command (shows up in seconds, instead of up to ~1h for
# a global command). Leave unset to register globally.
#DISCORD_GUILD_ID=

# Port the interactions.py / waitress service listens on locally. Whatever
# sits in front of it (Cloudflare Tunnel, a reverse proxy) forwards to this.
#PORT=8787
