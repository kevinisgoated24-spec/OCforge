# Copy to .env (and never commit the real one) or export these as real
# environment variables before running bot.py.

DISCORD_TOKEN=paste-your-bot-token-here

# Optional: which repo the /report link points at (defaults to
# kevinisgoated24-spec/OCforge — only change this if you forked it).
#GITHUB_REPO=kevinisgoated24-spec/OCforge

# Optional: restrict /report to one server (right-click the server icon in
# Discord with Developer Mode on -> Copy Server ID). Leave unset to allow
# any server the bot is invited to.
#DISCORD_GUILD_ID=
